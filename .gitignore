# Machine environments, caches and publication workspaces
.venv*/
.tools/
.cache/
.hf_cache/
.git-publish/
logs/
__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.*
!.env.example
# Current authority and research prose stay local; root README/legal notices are exceptions.
*.md
!/README.md
!THIRD_PARTY_NOTICES*.md
!**/LICENSE*
!**/COPYING*
!**/NOTICE*
!**/THIRD_PARTY_NOTICES*.md
local_research/
*.pdf
*.docx
*.pptx
*.zip
*.tar.gz
*.safetensors
*.pt
*.pth
# Full result trees stay local. The publisher selects bounded summaries explicitly.
results/
