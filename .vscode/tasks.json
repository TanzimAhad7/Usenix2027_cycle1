{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup venv (nohup)",
      "type": "shell",
      "command": "bash LAUNCH.sh setup setup_$(date -u +%Y%m%dT%H%M%SZ)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
