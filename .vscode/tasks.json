      "type": "shell",
      "command": "bash LAUNCH.sh figures figures_$(date -u +%Y%m%dT%H%M%SZ)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify delivered bytes",
